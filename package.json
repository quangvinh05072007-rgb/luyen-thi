{
  "name": "smartexam-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SmartExam AI — kiểm tra, đánh giá, học cá nhân hóa Toán THPT",
  "scripts": {
    "dev": "node server/dev.mjs",
    "start": "node server/index.mjs",
    "build": "vite build",
    "seed": "node server/seed.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "reset": "node server/reset.mjs",
    "restore": "node server/restore.mjs",
    "bench": "node tests/bench/bench.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tesseract.js-data/vie": "^1.0.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.11",
    "mathlive": "^0.111.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
